    local function MakeCoinCollector(cfg)
        local collecting, gen = false, 0
        local BATCH_SIZE, BATCH_DELAY, SCAN_DELAY = 40, 0.005, 0.03
        local RETRY_FAST, RETRY_SLOW = 0.25, 1
        return function(on)
            collecting = on
            gen += 1
            local myGen = gen
            if not on then return end
            local lastTouch = setmetatable({}, { __mode = "k" })
            local attempts = setmetatable({}, { __mode = "k" })
            local function TouchItem(obj)
                if not obj or not obj.Parent then return end
                lastTouch[obj] = _G.HyzePing.clock()
                attempts[obj] = (attempts[obj] or 0) + 1
                local hrp = getPart()
                if obj:IsA("BasePart") then touchPart(obj, hrp) end
                for _, d in ipairs(obj:GetDescendants()) do
                    if d:IsA("BasePart") then touchPart(d, hrp) end
                end
            end
            task.spawn(function()
                local folder = Workspace:WaitForChild(cfg.folderName, 8)
                if not folder then
                    warn(cfg.folderName .. " folder not found!")
                    return
                end
                local conn = folder.ChildAdded:Connect(function(obj)
                    if not collecting or gen ~= myGen then return end -- coins keep collecting during Stop activities
                    _G.HyzePing.wait()
                    TouchItem(obj)
                end)
                while collecting and gen == myGen do
                    do -- coins keep collecting during Stop activities / final upgrades
                        local due, now = {}, _G.HyzePing.clock()
                        for _, obj in ipairs(folder:GetChildren()) do
                            if obj:IsA("BasePart") or obj:IsA("Model") or obj:IsA("Folder") then
                                local t = lastTouch[obj]
                                local delay = ((attempts[obj] or 0) >= 4) and RETRY_SLOW or RETRY_FAST
                                if not t or now - t >= delay then due[#due + 1] = obj end
                            end
                        end
                        local idx = 1
                        while idx <= #due do
                            local endIdx = math.min(idx + BATCH_SIZE - 1, #due)
                            for i = idx, endIdx do TouchItem(due[i]) end
                            idx = endIdx + 1
                            if idx <= #due then _G.HyzePing.wait(BATCH_DELAY) end
                        end
                        _G.HyzePing.wait(SCAN_DELAY)
                    end
                end
                conn:Disconnect()
            end)
        end
    end
