-- Function to check if button is glowing/available
IsButtonUsable = function(button)
    if not button or not button:IsA("BasePart") then
        return false
    end
    
    -- Method 1: Check for Highlight (most common for selection glow)
    if button:FindFirstChild("Highlight") then
        return true
    end
    
    -- Method 2: Check Material (Neon = glowing)
    if button.Material == Enum.Material.Neon then
        return true
    end
    
    -- Method 3: Check for PointLight or SurfaceLight (actual light source)
    if button:FindFirstChildOfClass("PointLight") or button:FindFirstChildOfClass("SurfaceLight") then
        return true
    end
    
    -- Method 4: Check BillboardGui text color (green = available, red = locked)
    local billboard = button:FindFirstChildOfClass("BillboardGui")
    if billboard then
        local textLabel = billboard:FindFirstChildOfClass("TextLabel")
        if textLabel then
            local color = textLabel.TextColor3
            -- Green indicates available
            if color.G > 0.5 and color.R < 0.4 then
                return true
            end
        end
    end
    
    -- Method 5: Check if color is bright (glowing buttons are usually bright red/orange)
    local color = button.Color
    local brightness = (color.R + color.G + color.B) / 3
    if brightness > 0.6 then
        return true
    end
    
    -- Method 6: Check for "Available" attribute
    if button:GetAttribute("Available") == true then
        return true
    end
    
    return false
end

