    -- Visuals: Auto Hide GUI (hides the window a few seconds after joining; the open/close button stays)
    -- ============================================================
    --  WEBHOOK: progress reports (Rarity / Clovers / Coins + gain per hour) and Auto AFK notifications
    --  Embed look copied from the Hyze Nemu webhook (username Hyze, game title, player author, backtick fields, footer).
    -- ============================================================
    local wbOk, wbErr = pcall(function()
        local WT = Window:CreateTab("Webhook")
        local HttpService = game:GetService("HttpService")
        local WB = { url = "", min = 5, gen = 0, q = {}, S = {}, good = {}, busyReport = false }
        local CURRENCIES = {
            { id = "rarity",  label = "Rarity",  key = function() return dataKey("rarity") end },
            { id = "clovers", label = "Clovers", key = function() return "Clovers" end },
            { id = "coins",   label = "Coins",   key = function() return "Coins" end },
            { id = "cboost",  label = "Coin boost", key = function() return "CBoost" end }, -- PlayerData.CBoost (plain number, e.g. 1.512)
        }
        local NOTIFY_TITLES = { ["Auto AFK"] = true } -- notifications with these titles are forwarded to Discord

        -- ---- formatting ----
        local function fmtNum(n)
            if n ~= n then return "?" end
            if math.abs(n) >= 1e6 then
                local s = string.format("%.3e", n)
                return (s:gsub("e%+?(%-?)0*(%d+)", "e%1%2"))
            end
            if n >= 1000 or n == math.floor(n) then
                local s = string.format("%.0f", n)
                local r = s:reverse():gsub("(%d%d%d)", "%1,"):reverse()
                return (r:gsub("^,", ""))
            end
            return string.format("%.3f", n)
        end
        local function wbDur(secs)
            secs = math.max(0, math.floor(secs))
            local h, m, s = math.floor(secs / 3600), math.floor(secs % 3600 / 60), secs % 60
            if h > 0 then return string.format("%dh %02dm %02ds", h, m, s) end
            return string.format("%dm %02ds", m, s)
        end
        local function wbValidUrl(url)
            return type(url) == "string" and url:find("discord", 1, true) ~= nil and url:find("/api/webhooks/", 1, true) ~= nil
        end
        local function wbGameName()
            if not getgenv().HyzeGameName then
                local ok, name = pcall(function() return game:GetService("MarketplaceService"):GetProductInfo(game.PlaceId).Name end)
                getgenv().HyzeGameName = (ok and type(name) == "string" and name ~= "") and name or "Roblox"
            end
            return getgenv().HyzeGameName
        end

        -- ---- "layer;number" values ----
        local function parse(str)
            str = tostring(str or "")
            local layer, num = str:match("^(%d+);(.+)$")
            layer, num = tonumber(layer), tonumber(num)
            if layer and num then
                return { layer = layer, num = num }
            end
            -- plain number such as 2.9474062604503584e+22 (Coins is stored this way)
            local plain = tonumber(str)
            if plain then
                return { layer = 0, num = plain }
            end
            return nil
        end
        local function toAbs(p) -- plain number when it fits in a double, else nil
            if p.layer == 0 then return p.num end
            if p.layer == 1 and p.num < 300 then return 10 ^ p.num end
            return nil
        end
        local function toLog(p)
            if p.layer == 0 then return p.num > 0 and math.log10(p.num) or -math.huge end
            if p.layer == 1 then return p.num end
            return math.huge
        end
        local function isZero(p) return p.layer == 0 and p.num == 0 end
        local function fmtVal(p)
            local a = toAbs(p)
            if a then return fmtNum(a) end
            if p.layer == 1 then
                local e = math.floor(p.num)
                local m = 10 ^ (p.num - e)
                if m >= 9.9995 then m, e = 1, e + 1 end
                return string.format("%.3fe%d", m, e)
            end
            return p.layer .. ";" .. tostring(p.num)
        end
        local function fmtMult(dl)
            if dl < 6 then return string.format("%.4g", 10 ^ dl) end
            return string.format("10^%.2f", dl)
        end

        -- ---- reading the currencies (Rarity flickers to 0 between rolls, so zero readings are retried) ----
        local function readOne(c)
            local key = c.key()
            local best = nil
            for _ = 1, 6 do
                local pd = LocalPlayer:FindFirstChild("PlayerData")
                local v = pd and pd:FindFirstChild(key)
                if not v then return nil, key end
                local p = parse(tostring(v.Value))
                if p then
                    best = p
                    if not isZero(p) then WB.good[c.id] = p return p, key end
                end
                _G.HyzePing.wait(0.2)
            end
            if best and isZero(best) and c.id == "rarity" and WB.good.rarity then return WB.good.rarity, key end
            return best, key
        end
        local function readAll()
            local out, missing = {}, {}
            for _, c in ipairs(CURRENCIES) do
                local p, key = readOne(c)
                out[c.id] = p
                if not p then missing[#missing + 1] = key end
            end
            if #missing > 0 and not WB.warnedMissing then
                WB.warnedMissing = true
                Library.Notify("warning", "Webhook", "PlayerData not found: " .. table.concat(missing, ", ") .. " (use Copy PlayerData and send it to me)")
            end
            return out
        end

        -- ---- gain maths ----
        local function diff(pv, nw)
            local a, b = toAbs(pv), toAbs(nw)
            if a and b then
                if b < a then return nil, nil, true end
                return b - a, nil, false
            end
            local la, lb = toLog(pv), toLog(nw)
            if la == -math.huge or la == math.huge or lb == -math.huge or lb == math.huge then return nil, nil, false end
            if lb < la - 1e-9 then return nil, nil, true end
            return nil, lb - la, false
        end
        local function gainText(pv, nw, elapsed) -- gained, per hour
            if not pv or not nw then return "`-`", "`-`" end
            local g, dl, reset = diff(pv, nw)
            if reset then return "`reset`", "`-`" end
            local k = 3600 / math.max(elapsed, 1)
            if g then return "`+" .. fmtNum(g) .. "`", "`" .. fmtNum(g * k) .. "`" end
            if dl then return "`x" .. fmtMult(dl) .. "`", "`x" .. fmtMult(dl * k) .. "`" end
            return "`-`", "`-`"
        end

        -- ---- sending (same request / retry logic as the Nemu webhook) ----
        local function wbSend(payload)
            if not wbValidUrl(WB.url) then
                Library.Notify("error", "Webhook", "Paste a valid Discord webhook URL first")
                return false
            end
            local req = (type(request) == "function" and request) or (type(http_request) == "function" and http_request)
                or (syn and syn.request) or (http and http.request)
            if not req then
                Library.Notify("error", "Webhook", "Your executor has no request function")
                return false
            end
            local body = HttpService:JSONEncode(payload)
            for _ = 1, 2 do
                local ok, res = pcall(req, { Url = WB.url, Method = "POST", Headers = { ["Content-Type"] = "application/json" }, Body = body })
                if not ok or not res then
                    Library.Notify("error", "Webhook", "Request failed: " .. tostring(res):sub(1, 100))
                    return false
                end
                local code = res.StatusCode or res.Status
                if type(code) == "number" and code >= 200 and code < 300 then return true end
                if code == 429 then
                    local wait = 2
                    pcall(function() wait = tonumber(HttpService:JSONDecode(res.Body).retry_after) or 2 end)
                    _G.HyzePing.wait(math.clamp(wait, 1, 10))
                else
                    Library.Notify("error", "Webhook", "Discord answered HTTP " .. tostring(code))
                    return false
                end
            end
            return false
        end
