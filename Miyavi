    -- Clover collector (v3)
    -- Findings from the debug logs:
    --  * the clover folders only exist while you are in their area (workspace.clova is gone elsewhere) and the big
    --    field is called "clova1" in one session and "clova2" in another. The old collector waited 8s for ONE fixed
    --    name and then quit for good, which is why it only worked when you were standing there when you toggled it.
    --  * a whole field (1500 models) appears at once when the area loads - the worst moment to start touching.
    -- Now: the collector never quits, finds the folder by any of its names, waits until the area has finished
    -- loading, then ramps up slowly, and pauses when FPS or memory get too low.
    local MEM_LIMIT_MB = 1800 -- pause collecting above this (your logs showed ~1300-1430 MB while playing)
    local StatsMem = game:GetService("Stats")

    local function MakeCloverCollector(cfg)
        local collecting, collected, gen = false, {}, 0
        local sinceYield = 0
        local collectedN, lastN = 0, -1
        local status = "off"
        dbg.collectors[cfg.label] = function()
            return string.format("collector %s: on=%s status=%s collected=%d", cfg.label, tostring(collecting), status, collectedN)
        end
        local function throttle()
            sinceYield += 1
            local limit = cfg.partsPerFrame
            if smoothFps < 20 then limit = math.max(1, limit // 4)
            elseif smoothFps < 35 then limit = math.max(1, limit // 2) end
            if sinceYield >= limit then
                sinceYield = 0
                _G.HyzePing.wait()
            end
        end
        local function FastTouch(model)
            if not model or not model.Parent or collected[model] then return end
            collected[model] = true
            collectedN += 1
            dbg.last = cfg.label .. " touching " .. model.Name .. " (" .. #model:GetChildren() .. " children)"
            local hrp = getPart()
            for _, p in ipairs(model:GetDescendants()) do
                if p:IsA("BasePart") then
                    touchPart(p, hrp)
                    throttle()
                end
            end
        end
        local function GetAll(folder)
            local pref, rest = {}, {}
            local seen = 0
            for _, model in ipairs(folder:GetChildren()) do
                seen += 1
                if seen % 300 == 0 then _G.HyzePing.wait() end -- huge fields: never scan in a single frame
                if (model:IsA("Model") or model:IsA("Folder") or model:IsA("BasePart")) and not collected[model] then
                    local n = model.Name:lower()
                    if n:find("four") then table.insert(pref, 1, model)
                    else table.insert(rest, model) end
                end
            end
            for _, v in ipairs(rest) do table.insert(pref, v) end
            return pref
        end
        -- the folder with the most children among the names this collector knows
        local function resolveFolder()
            local best, bestN = nil, -1
            for _, name in ipairs(cfg.folderNames) do
                local f = Workspace:FindFirstChild(name)
                if f then
                    local n = #f:GetChildren()
                    if n > 0 and n > bestN then best, bestN = f, n end
                end
            end
            return best
        end
        local function memMb()
            local m = 0
            pcall(function() m = StatsMem:GetTotalMemoryUsageMb() end)
            return m
        end
        -- wait until the area has finished loading: child count stable for 4s, FPS ok
        local function settle(folder, myGen)
            status = "waiting for the area to load"
            local lastCount, stable, t0 = -1, 0, _G.HyzePing.clock()
            while collecting and gen == myGen and folder.Parent and _G.HyzePing.clock() - t0 < 25 do
                local n = #folder:GetChildren()
                if n == lastCount and smoothFps > 25 then stable += 1 else stable = 0 end
                lastCount = n
                if stable >= 2 then break end
                _G.HyzePing.wait(2)
            end
            dlog(cfg.label .. " area loaded: " .. lastCount .. " items, fps " .. math.floor(smoothFps))
        end

        return function(on)
            collecting = on
            gen += 1
            local myGen = gen
            dlog("collector " .. cfg.label .. (on and " ON" or " OFF"))
            if not on then
                status = "off"
                return
            end
            collected = {}
            collectedN = 0
            -- availability detector: looks for the folder EVERY SECOND (also while waiting / loading / collecting)
            local current
            task.spawn(function()
                local lastAvail
                while collecting and gen == myGen do
                    local f = resolveFolder()
                    current = f
                    local avail = f ~= nil
                    if avail ~= lastAvail then
                        lastAvail = avail
                        dlog(cfg.label .. (avail and (" AVAILABLE: workspace." .. f.Name .. " (" .. #f:GetChildren() .. " items)")
                            or " NOT available (the folder is missing or empty - go to the field)"))
                    end
                    _G.HyzePing.wait(1)
                end
            end)
            task.spawn(function()
                local lastFolder, lastPos, rampUntil, lastClear, memPaused, warned = nil, nil, 0, _G.HyzePing.clock(), false, false
                -- a toggle restored from your save must not start while the game is still loading in
                while collecting and gen == myGen and (not game:IsLoaded() or _G.HyzePing.clock() - dbg.startAt < 20) do
                    status = "starting (letting the game load first)"
                    _G.HyzePing.wait(1)
                end
                while collecting and gen == myGen do
                    local hrp = getPart()
                    local folder = current
                    if folder and not folder.Parent then folder = nil end
                    if not hrp then
                        status = "no character"
                        _G.HyzePing.wait(0.5)
                    elseif not folder then
                        -- nothing to collect here: just keep waiting (the folder appears when you enter the area)
                        if lastFolder then dlog(cfg.label .. " folder is gone (left the area)") end
                        lastFolder = nil
                        status = "waiting for the folder (go to the field)"
                        if not warned then
                            warned = true
                            dlog(cfg.label .. " waiting: none of " .. table.concat(cfg.folderNames, "/") .. " exists yet")
                        end
                        _G.HyzePing.wait(1)
                    else
                        warned = false
                        if folder ~= lastFolder then
                            lastFolder = folder
                            collected, collectedN, lastN = {}, 0, -1
                            local sample = {}
                            for i, c in ipairs(folder:GetChildren()) do
                                if i > 3 then break end
                                sample[#sample + 1] = c.Name .. ":" .. c.ClassName
                            end
                            dlog(cfg.label .. " found workspace." .. folder.Name .. ", " .. #folder:GetChildren() .. " children, e.g. " .. table.concat(sample, ", "))
                            settle(folder, myGen)
                            rampUntil = _G.HyzePing.clock() + 12 -- first 12s: one clover at a time
                            lastPos = getPart() and getPart().Position
                        end
                        if lastPos and (hrp.Position - lastPos).Magnitude > 150 then
                            -- you teleported: wait for the new area before touching anything
                            lastPos = hrp.Position
                            dlog(cfg.label .. " TELEPORT detected - waiting for the area to load")
                            collected, collectedN = {}, 0
                            settle(folder, myGen)
                            rampUntil = _G.HyzePing.clock() + 12
                        else
                            lastPos = hrp.Position
                            local mem = memMb()
                            if states.StopActivities then
                                status = "paused (Stop activities)"
                                _G.HyzePing.wait(0.5)
                            elseif mem > MEM_LIMIT_MB or (memPaused and mem > MEM_LIMIT_MB - 150) then
                                if not memPaused then
                                    memPaused = true
                                    dlog(cfg.label .. " PAUSED: memory " .. math.floor(mem) .. " MB is too high")
                                    Library.Notify("warning", cfg.label, "Paused: memory too high (" .. math.floor(mem) .. " MB)")
                                end
                                status = "paused (memory)"
                                _G.HyzePing.wait(1)
                            elseif smoothFps < 12 then
                                status = "paused (fps " .. math.floor(smoothFps) .. ")"
                                _G.HyzePing.wait(0.5)
                            else
                                memPaused = false
                                status = "collecting"
                                local clovers = GetAll(folder)
                                if #clovers ~= lastN then
                                    lastN = #clovers
                                    dlog(cfg.label .. " scan: " .. #clovers .. " to collect (folder has " .. #folder:GetChildren() .. ")")
                                end
                                local ramp = _G.HyzePing.clock() < rampUntil
                                local size = ramp and 1 or cfg.batchSize
                                local delay = ramp and math.max(cfg.batchDelay, 0.1) or cfg.batchDelay
                                local idx = 1
                                while idx <= #clovers and collecting and gen == myGen do
                                    local endIdx = math.min(idx + size - 1, #clovers)
                                    for i = idx, endIdx do FastTouch(clovers[i]) end
                                    idx = endIdx + 1
                                    if idx <= #clovers then _G.HyzePing.wait(delay) end
                                    if smoothFps < 12 or memMb() > MEM_LIMIT_MB then break end
                                end
                                if _G.HyzePing.clock() - lastClear > 5 then
                                    lastClear = _G.HyzePing.clock()
                                    local count = 0
                                    for _ in pairs(collected) do count += 1 end
                                    if count > 500 then collected = {}; collectedN = 0 end
                                end
                                _G.HyzePing.wait(cfg.scanDelay)
                            end
                        end
                    end
                end
            end)
        end
    end

    -- Clover 1 (MAIN world, workspace.clova): the original Miyavi collector, unchanged logic (same speed).
    -- It only waits for the folder instead of giving up when it is missing.
    local function MakeOriginalCollector(folderName)
        local collecting, collected, gen = false, {}, 0
        local collectedN = 0
        local BATCH_SIZE, BATCH_DELAY, SCAN_DELAY = 25, 0.005, 0.05
        dbg.collectors[folderName] = function()
            return string.format("collector %s (original): on=%s collected=%d", folderName, tostring(collecting), collectedN)
        end
        local function FastTouch(model)
            if not model or not model.Parent or collected[model] then return end
            collected[model] = true
            collectedN += 1
            dbg.last = folderName .. " touching " .. model.Name
            local hrp = getPart()
            if model:IsA("BasePart") then touchPart(model, hrp) end -- the clover itself is a single part
            for _, p in ipairs(model:GetDescendants()) do
                if p:IsA("BasePart") then touchPart(p, hrp) end
            end
        end
        local function GetAllClovers(folder)
            local five, four, three = {}, {}, {}
            for _, model in ipairs(folder:GetChildren()) do
                if (model:IsA("Model") or model:IsA("Folder") or model:IsA("BasePart")) and not collected[model] then
                    local name = model.Name:lower()
                    if name:find("five") then table.insert(five, model)
                    elseif name:find("four") then table.insert(four, model)
                    elseif name:find("three") then table.insert(three, model) end
                end
            end
            -- biggest first: five, then four, then three
            for _, v in ipairs(four) do table.insert(five, v) end
            for _, v in ipairs(three) do table.insert(five, v) end
            return five
        end
        return function(on)
            collecting = on
            gen += 1
            local myGen = gen
            dlog("collector " .. folderName .. (on and " ON" or " OFF"))
            if not on then return end
            collected = {}
            collectedN = 0
            task.spawn(function()
                local lastClear = _G.HyzePing.clock()
                while collecting and gen == myGen do
                    local folder = Workspace:FindFirstChild(folderName)
                    if not folder then
                        _G.HyzePing.wait(1)
                    else -- Clover 1 keeps collecting even during Stop activities / final upgrades
                        local clovers = GetAllClovers(folder)
                        local total, idx = #clovers, 1
                        while idx <= total and collecting and gen == myGen do
                            local endIdx = math.min(idx + BATCH_SIZE - 1, total)
                            for i = idx, endIdx do FastTouch(clovers[i]) end
                            idx = idx + BATCH_SIZE
                            if idx <= total then _G.HyzePing.wait(BATCH_DELAY) end
                        end
                        if _G.HyzePing.clock() - lastClear > 5 then
                            lastClear = _G.HyzePing.clock()
                            local count = 0
                            for _ in pairs(collected) do count += 1 end
                            if count > 500 then collected = {}; collectedN = 0 end
                        end
                        _G.HyzePing.wait(SCAN_DELAY)
                    end
                end
            end)
        end
    end

