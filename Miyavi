-- Shared alternating loop for Inc Luck / RP Upgrade
task.spawn(function()
    while true do
        if states.CycleMode and states.IncLuck and states.RPUpgrade then
            -- === CYCLE MODE ON: hand off when upgrade runs out ===
            if cyclePhase == "IncLuck" then
                local button = workspace.Buttons["Rebirth Upgrade11"]
                if button and button:IsA("BasePart") and IsButtonUsable(button) then
                    for i = 1, 3 do
                        firetouchinterest(part, button, 0)
                        firetouchinterest(part, button, 1)
                    end
                else
                    cyclePhase = "RPUpgrade"
                end
            else
                local button = workspace.Buttons:GetChildren()[25]
                if button and button:IsA("BasePart") and IsButtonUsable(button) then
                    for i = 1, 3 do
                        firetouchinterest(part, button, 0)
                        firetouchinterest(part, button, 1)
                    end
                else
                    cyclePhase = "IncLuck"
                end
            end
            task.wait(0.05)
        else
            -- === CYCLE MODE OFF: original behaviour ===
            if ShouldRun() and states.IncLuck then
                local button = workspace.Buttons["Rebirth Upgrade11"]
                if button and button:IsA("BasePart") then
                    for i = 1, 3 do
                        firetouchinterest(part, button, 0)
                        firetouchinterest(part, button, 1)
                    end
                end
                task.wait(0.05)
            end
            
            if ShouldRun() and states.RPUpgrade then
                local button = workspace.Buttons:GetChildren()[25]
                if button and button:IsA("BasePart") then
                    for i = 1, 3 do
                        firetouchinterest(part, button, 0)
                        firetouchinterest(part, button, 1)
                    end
                end
                task.wait(0.05)
            end
            
            if not states.IncLuck and not states.RPUpgrade then
                task.wait(0.1)
            elseif states.StopActivities then
                task.wait(0.5)
            end
        end
    end
end)

