-- ============================================
-- COLLECT CLOVERS - ADDED TO EXTRAS TAB
-- ============================================

local clovaFolder = workspace:WaitForChild("clova", 8)
if not clovaFolder then
    warn("clova folder not found!")
else
    local collecting = false
    local collected = {}

    local BATCH_SIZE = 25
    local BATCH_DELAY = 0.005
    local SCAN_DELAY = 0.05

    local function FastTouch(model)
        if not model or not model.Parent then return end
        if collected[model] then return end
        
        collected[model] = true
        
        for _, partObj in ipairs(model:GetDescendants()) do
            if partObj:IsA("BasePart") then
                pcall(function()
                    firetouchinterest(part, partObj, 0)
                    firetouchinterest(part, partObj, 1)
                end)
            end
        end
    end

    local function ProcessBatch(clovers, startIdx)
        local endIdx = math.min(startIdx + BATCH_SIZE - 1, #clovers)
        for i = startIdx, endIdx do
            FastTouch(clovers[i])
        end
        return endIdx < #clovers
    end

    local function GetAllClovers()
        local four = {}
        local three = {}
        
        for _, model in ipairs(clovaFolder:GetChildren()) do
            if model:IsA("Model") or model:IsA("Folder") then
                if not collected[model] then
                    local name = model.Name:lower()
                    if name:find("four") then
                        table.insert(four, model)
                    elseif name:find("three") then
                        table.insert(three, model)
                    end
                end
            end
        end
        
        for _, v in ipairs(three) do
            table.insert(four, v)
        end
        
        return four
    end

    local function TurboCollect()
        while collecting do
            if states.StopActivities then
                task.wait(0.5)
            else
                local clovers = GetAllClovers()
                local total = #clovers
                
                if total > 0 then
                    local idx = 1
                    while idx <= total do
                        local hasMore = ProcessBatch(clovers, idx)
                        idx = idx + BATCH_SIZE
                        if hasMore then
                            task.wait(BATCH_DELAY)
                        end
                    end
                end
                
                task.wait(SCAN_DELAY)
            end
        end
    end

    task.spawn(function()
        while true do
            task.wait(5)
            if not collecting then break end
            local count = 0
            for _ in pairs(collected) do count = count + 1 end
            if count > 500 then
                collected = {}
            end
        end
    end)

    ExtrasTab:AddToggle("CollectCloversToggle", {
        Title = "Collect clovers",
        Description = "Max speed ghost collect all clovers",
        Default = false,
        Callback = function(Value)
            collecting = Value
            
            if Value then
                collected = {}
                task.spawn(TurboCollect)
            end
        end
    })
end

