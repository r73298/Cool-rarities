    IsButtonUsable = function(button)
        if not button or not button:IsA("BasePart") then return false end
        if button:FindFirstChild("Highlight") then return true end
        if button.Material == Enum.Material.Neon then return true end
        if button:FindFirstChildOfClass("PointLight") or button:FindFirstChildOfClass("SurfaceLight") then return true end
        local billboard = button:FindFirstChildOfClass("BillboardGui")
        if billboard then
            local textLabel = billboard:FindFirstChildOfClass("TextLabel")
            if textLabel then
                local c = textLabel.TextColor3
                if c.G > 0.5 and c.R < 0.4 then return true end
            end
        end
        local c = button.Color
        if (c.R + c.G + c.B) / 3 > 0.6 then return true end
        if button:GetAttribute("Available") == true then return true end
        return false
    end

