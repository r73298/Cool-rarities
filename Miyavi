        out[#out + 1] = string.format("folders: clova=%d clova1=%d clova2=%d coins=%d", countOf("clova"), countOf("clova1"), countOf("clova2"), countOf("coins"))
        for _, fn in pairs(dbg.collectors) do
            local ok, s = pcall(fn)
            if ok then out[#out + 1] = s end
        end
        local active = {}
        for k, v in pairs(states) do if v == true then active[#active + 1] = k end end
