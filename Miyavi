        out[#out + 1] = "ON: " .. (#active > 0 and table.concat(active, ", ") or "-")
        out[#out + 1] = "last action: " .. tostring(dbg.last)
        if dbg.scan and dbg.scan.on then out[#out + 1] = dbg.scan.text end
