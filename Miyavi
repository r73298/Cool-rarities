    local buttonCache, lastLookup = {}, {}
    local function GetButton(key)
        local cached = buttonCache[key]
        if cached and cached.Parent == ButtonsFolder then return cached end
        if lastLookup[key] and _G.HyzePing.clock() - lastLookup[key] < 1 then return nil end
        lastLookup[key] = _G.HyzePing.clock()
        local spec = BUTTON_SPECS[key]
        -- relaxed = true: only the pinned _name (and zone) must match, not the Script.* stat properties (used only for _loose specs)
        local function scan(relaxed)
            local fallback
            for _, b in ipairs(ButtonsFolder:GetChildren()) do
                if b:IsA("BasePart") then
                    local good = true
                    if spec._name and b.Name ~= spec._name then good = false end
                    if good and not relaxed then
                        for stat, want in pairs(spec) do
                            if string.sub(stat, 1, 1) ~= "_" and readVal(b, stat) ~= want then good = false; break end
                        end
                    end
                    if good and spec._zone == "far" then
                        good = b.Position.Z > 5000
                    elseif good and spec._zone == "main" then
                        good = IsMainZone(b)
                    end
                    if good and spec._notMain then good = not IsMainZone(b) end
                    if good then
                        if IsMainZone(b) then return b end
                        fallback = fallback or b
                    end
                end
            end
            return fallback
        end
        local found = scan(false)
        if not found and key == "Secret2" then
            local okI, b84 = pcall(function() return ButtonsFolder:GetChildren()[84] end)
            if okI and b84 and b84:IsA("BasePart") and b84.Name == "Rebirth Upgrade 7" then found = b84 end
        end
        if not found and spec._loose then
            found = scan(true)
            if found then pcall(function() dlog("GetButton(" .. key .. "): matched by name only (stat properties differ from BUTTON_SPECS)") end) end
        end
        buttonCache[key] = found
        return found
    end

