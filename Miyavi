    -- ============================================================
    --  AUTO AFK PROGRESSION  (hierarchical state machine)
    --  Tiers:  Roll Rarity  <  Rebirth  <  Super Multi Get (SM)  <  Prestige  <  Ascension
    --  A higher tier resets every tier below it, so its tracking is cleared and the lower tiers are REBUILT
    --  (the script keeps farming until the previous milestone is reached again - recovery is never skipped).
    --
    --  Efficiency of a tier = how much FASTER the previous milestone was rebuilt than last cycle:
    --      improvement% = (previousRecoveryTime - currentRecoveryTime) / previousRecoveryTime * 100  (negative -> 0)
    --      >= 10% stay on this tier    5-10% keep monitoring    <= 5% advance to the next tier
    --  Rebirth is triggered when the remaining rarity to its requirement is below 5%.
    --  Values in PlayerData are "layer;number" (1;677.49 = 10^677.49): everything is compared through log10,
    --  so huge numbers never overflow.
    --
    --  Data keys (change with getgenv().HyzeKeys = { sm = "UpgradesMultiMulti", ... } before running):
    --     rarity = Rarity, rebirth = RebirthPoints, sm = UpgradesMultiMulti, prestige = PrestigePoints,
    --     rebirthMark = RebirthCount, ascension = Ascension
    -- ============================================================
    local AFK = {
        gen = 0, busy = false, mode = "rebirth", cycle = 1,
        t = { rebirth = {}, sm = {}, prestige = {} }, -- per-tier tracking: milestone / recovery times / flags
        lastTry = {},
        ascLimit = 0, ascLimitMsg = false, -- max Ascension to reach (0 = no limit); set from the Extras tab
        waitSec = 60, waitStart = {}, -- slider: seconds to keep farming once SM / Prestige is ready, before the final upgrades
        minSM = 0, smCount = 0, -- Extras slider: Prestige waits until this many SM resets happened since the last Prestige / Ascension (0 = off)
        noSecret2 = false, -- Extras toggle: true = the final upgrade is ONLY Rebirth Upgrade 7 (Secret 2 left out everywhere)
        finalStop = true, -- Extras toggle: true = Prestige buys the final upgrades first (original); false = buy the final upgrades for 3s only, then Prestige
        skipSecretTog = false, skipSecretN = 0, -- Extras: skip Secret 2 on the first N SM cycles before a Prestige (toggle + number box)
    }
    -- true when Secret 2 must be left out of the final upgrade of the SM cycle that is about to run.
    -- AFK.smCount = SM resets done since the last Prestige / Ascension, so with N = 2: SM 1/3 skips, SM 2/3 skips, SM 3/3 does Secret 2.
    local function skipSecretThisSM(label)
        if label ~= "SM" then return false end
        if not AFK.skipSecretTog then return false end
        local n = AFK.skipSecretN or 0
        if n <= 0 then return false end
        return (AFK.smCount or 0) < n
    end
    -- Ascension is NOT part of the sequence: it fires on its own whenever it is possible (see the loop) and resets the tracking
    local NEXT_MODE = { rebirth = "sm", sm = "prestige" }
    -- Prestige gate state: peak = highest Roll Rarity (log10) seen since the last Prestige,
    -- oldRarity = that peak at the moment of the last verified Prestige, waitSince/lastMsg = wait bookkeeping
    local PG = { peak = nil, oldRarity = nil, waitSince = nil, lastMsg = 0, needSM = false }
    local KEYS = {
        rarity = "Rarity", rebirth = "RebirthPoints", sm = "UpgradesMultiMulti",
        prestige = "PrestigePoints", rebirthMark = "RebirthCount", ascension = "Ascension",
    }

    local function dataKey(name)
        if type(getgenv) == "function" then
            local custom = getgenv().HyzeKeys
            if type(custom) == "table" and type(custom[name]) == "string" then return custom[name] end
        end
        return KEYS[name]
    end

    local function playerData(name)
        local pd = LocalPlayer:FindFirstChild("PlayerData")
        local v = pd and pd:FindFirstChild(name)
        return v and tostring(v.Value) or nil
    end

    -- "layer;number" -> log10 of the value (layer 0 = plain number, layer 1 = 10^number). Level 1 = 0.
    local function logOf(str)
        local layer, num = tostring(str or ""):match("^(%d+);(.+)$")
        layer, num = tonumber(layer), tonumber(num)
        if not layer or not num then return nil end
        if layer == 0 then return num > 0 and math.log10(num) or -math.huge end
        if layer == 1 then return num end
        return math.huge
    end
    local function metric(name) return logOf(playerData(dataKey(name))) end

    -- remaining % to a requirement (both as log10): ((req - cur) / req) * 100, never divides by zero
    local function remainingPct(curL, reqL)
        if curL == nil or reqL == nil then return nil end
        if curL >= reqL then return 0 end
        local d = curL - reqL
        if d == -math.huge or d < -12 then return 100 end
        return (1 - 10 ^ d) * 100
    end

    -- the Script.Requiredrarity value of a button (log10), nil when the button has none (0)
    local function requirementOf(btn)
        local sc = btn and btn:FindFirstChild("Script")
        local v = sc and sc:FindFirstChild("Requiredrarity")
        local l = v and logOf(tostring(v.Value))
        if l and l > -math.huge then return l end
        return nil
    end

    local costReady -- forward declaration (defined below)
    local function dropped(before, now)
        if before == nil or now == nil or before == -math.huge then return false end
        return now < before - 0.3
    end

    -- ===== SM / FINAL UPGRADE DEBUG (Extras tab > "Copy SM debug log") =====
    local SMD = { lines = {}, on = true, t0 = _G.HyzePing.clock() }
    local function smd(msg)
        if not SMD.on then return end
        local l = SMD.lines
        l[#l + 1] = string.format("[%7.1f] %s", _G.HyzePing.clock() - SMD.t0, tostring(msg))
        if #l > 1500 then table.remove(l, 1) end
        pcall(function() if dbg and dbg.log then dbg.log("SMD " .. tostring(msg)) end end)
        -- also save to the executor workspace: Workspace/Hyze/SM_debug.txt (rewritten on every line)
        pcall(function()
            if type(writefile) ~= "function" then return end
            if type(makefolder) == "function" and type(isfolder) == "function" and not isfolder("Hyze") then makefolder("Hyze") end
            writefile("Hyze/SM_debug.txt", "== SM DEBUG LOG ==\n" .. table.concat(l, "\n") .. "\n")
        end)
    end
    local function smdState(tag)
        local pd = LocalPlayer:FindFirstChild("PlayerData")
        local function raw(k) local v = pd and pd:FindFirstChild(dataKey(k)); return v and tostring(v.Value) or "nil" end
        smd(string.format("%s | rarityRaw=%s rarityLog=%s | rebirthRaw=%s | smRaw=%s | prestigeRaw=%s | StopAct=%s busy=%s mode=%s smCount=%s",
            tag, raw("rarity"), tostring(metric("rarity")), raw("rebirth"), raw("sm"), raw("prestige"),
            tostring(states.StopActivities), tostring(AFK.busy), tostring(AFK.mode), tostring(AFK.smCount)))
    end
    local function smdBtn(label, btn)
        if not btn then smd(label .. ": button = nil") return end
        local sc = btn:FindFirstChild("Script")
        local function val(n) local v = sc and sc:FindFirstChild(n); return v and tostring(v.Value) or "nil" end
        local statKey = sc and sc:FindFirstChild("Whatstatcost")
        local gives = sc and sc:FindFirstChild("Whatstatgives")
        smd(string.format("%s: %s | Cost=%s | CostStat=%s (have %s) | GivesStat=%s (have %s) | costReady=%s",
            label, btn.Name, val("Cost"), val("Whatstatcost"),
            statKey and tostring(playerData(tostring(statKey.Value))) or "nil",
            val("Whatstatgives"), gives and tostring(playerData(tostring(gives.Value))) or "nil",
            tostring((function() local ok, r = pcall(function() return costReady(btn) end) return ok and r or "err" end)())))
    end

    local function snapshot()
        return {
            rarity = metric("rarity"), rp = metric("rebirth"), sm = metric("sm"),
            rmark = (playerData(dataKey("rebirthMark")) or "") .. "|" .. (playerData(dataKey("rebirth")) or ""),
            amark = playerData(dataKey("ascension")) or "",
        }
    end

    -- ---- the tiers: button, what gets rebuilt after it (metric), what it resets, how to verify it happened ----
    local TIERS = {
        rebirth = {
            btn = function() return ButtonsFolder:FindFirstChild("Rebirth Get") or GetButton("Rebirth") end,
            rebuild = function() return metric("rarity") end, -- Roll Rarity
            lower = {},
            verify = function(b) return (snapshot().rmark ~= b.rmark) end,
        },
        sm = {
            btn = function() return ButtonsFolder:FindFirstChild("Super Multi Get") end,
            rebuild = function() return metric("rebirth") end, -- Rebirth (and Roll Rarity)
            lower = { "rebirth" },
            verify = function(b) return dropped(b.rp, metric("rebirth")) and dropped(b.rarity, metric("rarity")) end,
        },
        prestige = {
            btn = function() return ButtonsFolder:FindFirstChild("Prestige Get") end,
            rebuild = function() return metric("sm") end, -- SM (and Rebirth, Roll Rarity)
            lower = { "sm", "rebirth" },
            verify = function(b) return dropped(b.sm, metric("sm")) and dropped(b.rp, metric("rebirth")) end,
        },
        ascension = {
            btn = function()
                local f = Workspace:FindFirstChild("asecnd")
                return f and f:FindFirstChild("RollRarity")
            end,
            lower = { "prestige", "sm", "rebirth" },
            verify = function(b) return (snapshot().amark ~= b.amark) end,
        },
    }

    -- ---- Roll Rarity: workspace["Roll System"].RollRarity, activated according to what it really is ----
    local rollTargets, rollScan = {}, 0
    local function refreshRollTargets()
        if _G.HyzePing.clock() - rollScan < 5 then return end
        rollScan = _G.HyzePing.clock()
        rollTargets = {}
        local sys = Workspace:FindFirstChild("Roll System")
        local obj = sys and sys:FindFirstChild("RollRarity")
        if not obj then return end
        local function consider(o)
            if #rollTargets >= 20 then return end
            if o:IsA("BasePart") or o:IsA("ClickDetector") or o:IsA("ProximityPrompt") then
                rollTargets[#rollTargets + 1] = o
            end
        end
        consider(obj)
        for _, d in ipairs(obj:GetDescendants()) do consider(d) end
    end
    local function rollOnce()
        if _G.HyzePing.paused then return end
        refreshRollTargets()
        local hrp = getPart()
        for _, o in ipairs(rollTargets) do
            if o.Parent then
                if o:IsA("BasePart") then
                    for _ = 1, 5 do touchPart(o, hrp) end
                elseif o:IsA("ClickDetector") and type(fireclickdetector) == "function" then
                    pcall(fireclickdetector, o)
                elseif o:IsA("ProximityPrompt") and type(fireproximityprompt) == "function" then
                    pcall(fireproximityprompt, o)
                end
            end
        end
    end

    local function runUpgrades()
        -- Rebirth Upgrade 7 is NOT bought here: it is only bought in finalUpgrades() (the final upgrade phase)
        for _, key in ipairs({ "IncLuck", "RPUpgrade" }) do
            Touch(GetButton(key), 3)
            _G.HyzePing.wait(0.05)
        end
    end
    -- ---- recovery tracking ----
    local function evaluate(name, rec)
        -- efficiency decision, only for the tier that is currently being optimised
        -- (needs 2 low results IN A ROW to advance; a slower rebuild is "no data", not a low result)
        if AFK.mode ~= name or not NEXT_MODE[name] then return end
        local function advance(msg)
            AFK.mode = NEXT_MODE[name]
            Library.Notify("info", "Auto AFK", msg .. " -> advancing to " .. tostring(AFK.mode))
        end
        if name ~= "rebirth" then
            -- SM and Prestige tiers keep the ORIGINAL rule: 10%+ stay, 5% or less advance (slower counts as 0%)
            if rec.impr == nil then return end
            if rec.impr <= 5 then
                advance(string.format("%s recovery improved %.1f%%", name, rec.impr))
            end
            return
        end
        -- Rebirth tier (this is what unlocks the SM Upgrade): stricter rule below
        if rec.slower then
            -- slower than last cycle: no data. Safety so it can never get stuck on this tier: 3 slower in a row advances
            rec.slowStreak = (rec.slowStreak or 0) + 1
            if rec.slowStreak >= 3 then
                advance(string.format("%s recovery was slower 3x in a row", name))
            end
            return
        end
        if rec.impr == nil then return end
        rec.slowStreak = 0
        if rec.impr >= 10 then
            rec.lowStreak = 0
            return -- continue this tier
        elseif rec.impr <= 5 then
            rec.lowStreak = (rec.lowStreak or 0) + 1
            if rec.lowStreak >= 2 then
                advance(string.format("%s recovery improved only %.1f%% (2nd low result in a row)", name, rec.impr))
            else
                Library.Notify("info", "Auto AFK", string.format("%s recovery improved only %.1f%% (1/2) - monitoring", name, rec.impr))
            end
        else
            rec.lowStreak = 0 -- 5-10%: keep monitoring
        end
    end

    local function updateRecoveries()
        for name, rec in pairs(AFK.t) do
            if rec.recovering then
                local cur = TIERS[name].rebuild()
                -- Rebirth's 80-second skip is handled by the independent mode timer in afkLoop.
                -- Recovery completion is still measured normally; it is no longer used as the 80s trigger.
                if cur ~= nil and rec.target ~= nil and cur >= rec.target - 1e-9 then
                    local took = _G.HyzePing.clock() - rec.recStart
                    rec.recovering = false
                    local prev = rec.prevTime
                    rec.impr, rec.slower = nil, false
                    if prev and prev > 0 then
                        if took > prev and name == "rebirth" then
                            rec.slower = true -- Rebirth tier only: slower than last cycle = no data (not "0% improvement")
                        else
                            rec.impr = math.max(0, (prev - took) / prev * 100) -- original rule (SM / Prestige tiers)
                        end
                    end
                    rec.prevTime = took
                    evaluate(name, rec)
                    -- Let the main loop decide whether to continue to Prestige or cycle back.
                    if name == "sm" then AFK.smRecoveryJustFinished = true end
                elseif _G.HyzePing.clock() - rec.recStart > 1800 then
                    rec.recovering = false -- never stuck: give up on this measurement (no comparison made)
                    pcall(function()
                        Library.Notify("warning", "Auto AFK", string.format(
                            "%s recovery gave up after 30 min (rebuilt %.2f / target %.2f, log10) - next tier may fire early",
                            name, cur or -1, rec.target or -1))
                    end)
                end
            end
        end
    end

    local function anyRecovering(...)
        for _, name in ipairs({ ... }) do
            if AFK.t[name] and AFK.t[name].recovering then return true end
        end
        return false
    end

    -- ---- performing a reset action ----
    local function performReset(name, gen)
        local T = TIERS[name]
        local btn = T.btn()
        AFK.lastTry[name] = _G.HyzePing.clock()
        if not (btn and btn:IsA("BasePart")) then return false end
        local before = snapshot()
        local milestone = T.rebuild and T.rebuild() or nil
        AFK.busy = true
        local ok, result = pcall(function()
            local t0 = _G.HyzePing.clock()
            local limit = (name == "ascension") and 10 or 6 -- a failed Ascension try must not hold the whole cycle for long
            if name == "prestige" then
                for _ = 1, 2 do -- Prestige only: 2 extra touches, 1 second apart; the original touch below is the 3rd
                    if AFK.gen ~= gen then return false end
                    touchPart(btn, getPart())
                    _G.HyzePing.wait(1)
                end
            end
            while AFK.gen == gen and _G.HyzePing.clock() - t0 < limit do
                local hrp = getPart()
                for _ = 1, (name == "ascension") and 5 or 1 do touchPart(btn, hrp) end
                _G.HyzePing.wait(0.4)
                if T.verify(before) then
                    _G.HyzePing.wait(1.5) -- let the reset and the new values settle
                    return true
                end
                if name ~= "ascension" then
                    -- one touch is enough for normal resets: just wait for the result
                    for _ = 1, 8 do
                        if AFK.gen ~= gen then return false end
                        _G.HyzePing.wait(0.25)
                        if T.verify(before) then _G.HyzePing.wait(1.5) return true end
                    end
                    return false
                end
            end
            return false
        end)
        AFK.busy = false
        if not (ok and result) then return false end

        -- verified: clear every tier this action reset, then start measuring the rebuild
        for _, low in ipairs(T.lower) do AFK.t[low] = {} end
        if name == "sm" then
            AFK.smCount = (AFK.smCount or 0) + 1
            if (AFK.minSM or 0) > 0 then
                Library.Notify("info", "Auto AFK", string.format("SM %d / %d before Prestige", AFK.smCount, AFK.minSM))
            end
        elseif name == "prestige" or name == "ascension" then
            AFK.smCount = 0
        end
        if name == "prestige" then
            -- remember the rarity this Prestige was done at: the next Prestige waits to rebuild it
            local top = math.max(PG.peak or -math.huge, before.rarity or -math.huge)
            PG.oldRarity = (top > -math.huge) and top or PG.oldRarity
            PG.peak, PG.waitSince = nil, nil
        elseif name == "ascension" then
            PG.peak, PG.oldRarity, PG.waitSince = nil, nil, nil
        end
        if name == "ascension" then
            AFK.t = { rebirth = {}, sm = {}, prestige = {} }
            AFK.s2Retry, AFK.s2State = nil, nil -- new Ascension cycle: no Secret 2 hold carried over
            AFK.mode, AFK.cycle = "rebirth", AFK.cycle + 1
            Library.Notify("success", "Auto AFK", "Ascended - cycle " .. AFK.cycle .. " (all tracking reset to Level 1)")
        else
            local rec = AFK.t[name]
            rec.milestone, rec.target, rec.recStart = milestone, milestone, _G.HyzePing.clock()
            rec.recovering = milestone ~= nil and milestone > 0 -- Level 1 milestone: nothing to rebuild
        end
        return true
    end

    -- cost check from the button itself: Script.Cost vs your Script.Whatstatcost value (nil = cannot tell)
    costReady = function(btn)
        local sc = btn and btn:FindFirstChild("Script")
        local cost = sc and sc:FindFirstChild("Cost")
        local stat = sc and sc:FindFirstChild("Whatstatcost")
        if not (cost and stat) then return nil end
        local costL = logOf(tostring(cost.Value))
        local curL = logOf(playerData(tostring(stat.Value)))
        if costL == nil or curL == nil then return nil end
        return curL >= costL
    end

    -- ---- readiness ----
    local function ready(name, ignoreCooldown)
        local cooldown = (name == "rebirth") and 3 or 8
        if not ignoreCooldown and _G.HyzePing.clock() - (AFK.lastTry[name] or 0) < cooldown then return false end
        local T = TIERS[name]
        local btn = T.btn()
        if not btn then return false end
        if name == "sm" and costReady(btn) == false then return false end -- SM needs its multiplier cost
        local req = requirementOf(btn)
        local cur = metric("rarity")
        if req and cur then
            return remainingPct(cur, req) < 5 -- remaining progression below 5%
        end
        return true -- requirement not readable: try it, the result is verified before anything is recorded
    end

    -- ---- Prestige value calculator ----
    -- Prestige only fires when ALL of these hold (on top of ready("prestige"), the button's own requirement):
    --   1. Roll Rarity has been rebuilt to your OLD Prestige rarity (the peak before the last Prestige; remaining < 5%,
    --      the same rule Rebirth uses). Not tied to the Rebirth / SM rarity - each tier keeps its own number.
    --   2. an SM Upgrade is AVAILABLE (affordable from its own Cost vs your stat). Prestige is only the thing waiting;
    --      the SM Upgrade itself is not bought by this gate.
    -- Safety: if it has been waiting longer than getgenv().HyzeSMWaitMax (default 900s) it stops waiting, so it is never stuck.
    local function smUpgradeAvailable()
        local known, any = false, false
        for _, n in ipairs({ "Super Multi Upgrade1", "Super Multi Upgrade2" }) do
            local c = costReady(ButtonsFolder:FindFirstChild(n))
            if c ~= nil then known = true end
            if c == true then any = true end
        end
        if not known then return true, "SM Upgrade cost unreadable (not blocking)" end
        return any, any and "SM Upgrade available" or "SM Upgrade not affordable yet"
    end

    local finalUpgradesAvailable -- defined below (needs isMaxedText)

    local function prestigeGate()
        -- minimum SM resets before Prestige (Extras slider). Not enough yet -> Prestige is denied and SM keeps running.
        -- The 900s limit does not run while it waits for this count.
        local minSM = AFK.minSM or 0
        if minSM > 0 and (AFK.smCount or 0) < minSM then
            PG.needSM = true
            PG.why = string.format("SM %d/%d before Prestige", AFK.smCount or 0, minSM)
            PG.waitSince = nil
            if _G.HyzePing.clock() - PG.lastMsg > 60 then
                PG.lastMsg = _G.HyzePing.clock()
                Library.Notify("info", "Auto AFK", "Prestige waiting: " .. PG.why)
            end
            return false
        end
        PG.needSM = false
        local cur = metric("rarity")
        local ok, why = true, "ok"
        if PG.oldRarity and cur and remainingPct(cur, PG.oldRarity) >= 5 then
            ok, why = false, string.format("rarity %.2f / old Prestige rarity %.2f (log10)", cur, PG.oldRarity)
        end
        if ok then
            local avail, msg = smUpgradeAvailable()
            if not avail then ok, why = false, msg end
        end
        if ok then -- the final upgrades (Rebirth Upgrade 7, Secret 2) must be available (or already maxed) too
            local avail, msg = finalUpgradesAvailable()
            if not avail then ok, why = false, msg end
        end
        PG.why = (not ok) and why or nil
        if ok then
            PG.waitSince = nil
            return true
        end
        PG.waitSince = PG.waitSince or _G.HyzePing.clock()
        local maxWait = (type(getgenv) == "function" and tonumber(getgenv().HyzeSMWaitMax)) or 900
        if _G.HyzePing.clock() - PG.waitSince > maxWait then
            Library.Notify("warning", "Auto AFK", "Prestige waited " .. maxWait .. "s (" .. why .. ") - going ahead")
            PG.waitSince = nil
            return true
        end
        if _G.HyzePing.clock() - PG.lastMsg > 60 then
            PG.lastMsg = _G.HyzePing.clock()
            Library.Notify("info", "Auto AFK", "Prestige waiting: " .. why)
        end
        return false
    end

    -- ---- SM preparation: buy an upgrade until it is maxed / can no longer be afforded ----
    local function isMaxedText(btn)
        for _, d in ipairs(btn:GetDescendants()) do
            if d:IsA("TextLabel") then
                local t = d.Text:lower()
                if t:find("bought", 1, true) or t:find("maxed", 1, true) or t == "max" then return true end
            end
        end
        return false
    end

    finalUpgradesAvailable = function()
        -- { label, button, gates Prestige? }
        -- Secret 2 is the space-area "Rebirth Upgrade 7" (child [84]), and it NEVER gates Prestige: it shares its progression with
        -- Rebirth Upgrade 7 and keeps accepting purchases while the game shows it as maxed / unaffordable, so its displayed
        -- Cost / "Bought!" text is not proof that it cannot be bought. maxOut() decides by watching the real stat instead.
        local list = {
            { "Rebirth Upgrade 7", GetButton("RebirthUpg7"), true },
            { "Secret 2", GetButton("Secret2"), false },
        }
        if AFK.noSecret2 then list[2] = nil end -- Secret 2 removed from the final upgrade
        -- available = you can afford it right now (its Cost vs your stat). There is no "max": the final upgrade is
        -- simply bought repeatedly (maxOut) until it costs more than you have.
        local known = false
        for _, e in ipairs(list) do
            local btn = e[2]
            if btn and e[3] then
                local c = costReady(btn)
                if c ~= nil then known = true end
                if c == false then return false, "final upgrade not affordable yet: " .. e[1] end
            end
        end
        if not known then return true, "final upgrades unreadable (not blocking)" end
        return true, "final upgrades available"
    end

    -- a reset (Rebirth / SM / Prestige / Ascension) happened since the final upgrade started: Roll Rarity dropped.
    -- While the final upgrade runs the script does not roll, so a drop means you (or the game) reset -> stop buying.
    -- Prestige button watcher: while a final upgrade runs, ANY touch of the "Prestige Get" button by your character
    -- (you pressing it) counts as "Prestige pressed" and stops the final upgrade right away.
    local FIN = { pressed = false, conn = nil }
    local function finWatchStart()
        FIN.pressed = false
        if FIN.conn then pcall(function() FIN.conn:Disconnect() end) FIN.conn = nil end
        local pb = ButtonsFolder:FindFirstChild("Prestige Get")
        if pb and pb:IsA("BasePart") then
            FIN.conn = pb.Touched:Connect(function(hit)
                local ch = LocalPlayer.Character
                if ch and hit and hit:IsDescendantOf(ch) then FIN.pressed = true end
            end)
        end
    end
    local function finWatchStop()
        if FIN.conn then pcall(function() FIN.conn:Disconnect() end) FIN.conn = nil end
    end
    local resetLogged = false
    local function resetHappened(startRarity)
        if FIN.pressed then
            if not resetLogged then resetLogged = true smd("RESET TRIGGER: Prestige Get button was TOUCHED by your character (FIN.pressed)") smdState("at trigger") end
            return true
        end
        if startRarity == nil then return false end
        -- Roll Rarity reads 0 / -inf for a moment between rolls (seen in the SM debug log), so a 0 reading is NOT a reset.
        -- 1) a real reset collapses Rebirth Points (compared to the value when the final upgrade started)
        local rpNow = metric("rebirth")
        local rpDrop = false
        -- buying the final upgrade itself spends Rebirth Points (about 0.2 log10 in the log), so the limit is far above that:
        -- a real reset wipes them by thousands of log10 (or to 0)
        if AFK.finRP ~= nil and rpNow ~= nil and AFK.finRP > -math.huge then rpDrop = rpNow < AFK.finRP - 3 end
        -- 2) a Roll Rarity drop only counts when both readings are real numbers
        local rNow = metric("rarity")
        local rarDrop = false
        if rNow ~= nil and rNow > -math.huge and startRarity > -math.huge then rarDrop = dropped(startRarity, rNow) end
        if rpDrop then
            AFK.resetWhy = string.format("Rebirth Points dropped %.2f -> %.2f (log10)", AFK.finRP or -1, rpNow or -1)
        elseif rarDrop then
            AFK.resetWhy = string.format("Roll Rarity dropped %.2f -> %.2f (log10)", startRarity or -1, rNow or -1)
        end
        local d = rpDrop or rarDrop
        if d and not resetLogged then
            resetLogged = true
            smd("RESET TRIGGER: " .. tostring(AFK.resetWhy))
            smdState("at trigger")
        end
        return d
    end

    local function resetReason(startR)
        if FIN.pressed then return "Prestige button was touched" end
        if AFK.resetWhy then return AFK.resetWhy end
        return string.format("Roll Rarity dropped %.2f -> %.2f (log10)", startR or -1, metric("rarity") or -1)
    end

    -- keeps buying the button until it cannot be afforded any more (its own Cost vs your stat), it says Bought/Max,
    -- or nothing changes for a while. Changes are compared as RAW text, so it works whatever number format the game uses.
    -- Returns  ok, status, confirmed, state  (callers can tell a real finish from a stall/failure):
    --   confirmed = how many times the stat the button GIVES (the real upgrade value) was seen to change = real purchases
    --   ok        = false for: button missing, 600s timeout, or a STALL where no purchase was ever confirmed although the
    --               button still looked affordable/available (that is a failure, not a completed upgrade)
    --   state     = "finished" | "blocked-by-currency" | "failed" | "reset" | "cancelled".  ("timed-out" is NOT decided here:
    --               it is the 900 s Prestige-hold limit, see AFK.s2Decide.)  Only Secret 2 (opts.classify) can return
    --               "blocked-by-currency"; every other button keeps the original rule (unaffordable / maxed = finished).
    -- opts (optional, used for Secret 2):
    --   ignoreDisplay = true  : do not trust "Bought!"/Max text or the displayed Cost (Secret 2 keeps accepting purchases while
    --                           it looks maxed / unaffordable); only the real stat decides
    --   giveOnly = true       : progress = change of the gives stat only (the cost stat can change by itself and hide a stall)
    --   classify = true      : on a stall decide finished / blocked-by-currency / failed (see below)
    --   hintBtn = function    : button sharing the upgrade progression (Rebirth Upgrade 7). Its gives stat is only LOGGED when it
    --                           changes; it never counts as a purchase (the button's own gives stat is the only confirmation)
    --   stall = seconds       : seconds without progress before giving up (default 5)
    local function maxOut(gen, getBtn, label, startR, opts)
        opts = opts or {}
        local btn = getBtn()
        if not btn then
            Library.Notify("warning", "Auto AFK", label .. " button not found")
            smd("maxOut: " .. label .. " button not found")
            return false, "button not found", 0, "failed"
        end
        local function rawStat(b, which)
            local sc = b and b:FindFirstChild("Script")
            local v = sc and sc:FindFirstChild(which)
            local key = v and tostring(v.Value)
            return key and playerData(key) or nil
        end
        -- value of the upgrade itself = what THIS button gives (the only purchase confirmation)
        local function givesSig(b)
            if opts.givesKey then -- Secret 2: the confirmation stat is fixed (LuckMulti), independent of which button instance is touched
                local gk = playerData(opts.givesKey)
                return gk ~= nil and tostring(gk) or nil
            end
            local g = rawStat(b, "Whatstatgives")
            if g == nil then return nil end
            return tostring(g)
        end
        -- the shared button's gives stat (Upgrade 7): log-only hint, nil when it cannot be read right now (then it is skipped)
        local function hintVal()
            if not opts.hintBtn then return nil end
            local okH, hb = pcall(opts.hintBtn)
            if not (okH and hb) then return nil end
            local g = rawStat(hb, "Whatstatgives")
            return g ~= nil and tostring(g) or nil
        end
        -- log10 of the currency this button is paid with (Script.Whatstatcost); nil when unreadable
        local function costLog(b)
            local raw = rawStat(b, "Whatstatcost")
            return raw ~= nil and logOf(raw) or nil
        end
        local function sig(b)
            local g = givesSig(b)
            if opts.giveOnly and g ~= nil then return g end
            return tostring(rawStat(b, "Whatstatgives")) .. "|" .. tostring(rawStat(b, "Whatstatcost"))
        end
        local last = sig(btn)
        local lastGive = givesSig(btn)
        local hintLast = hintVal()
        local cLast = costLog(btn) -- currency at the last progress point (used to see whether it is rising)
        local confirmed = 0
        local t0 = _G.HyzePing.clock()
        local lastChange, lastConfirm = t0, t0
        local STALL = opts.stall or 5 -- seconds without any change before giving up on this button
        local NOCONF = 30 -- readable gives stat that never changes for this long = no real purchase, whatever else changes
        local reason, iters, buys = "loop ended (gen changed or 600s)", 0, 0
        local ok, status, state = nil, nil, nil
        smd("maxOut START: " .. label .. " | startR=" .. tostring(startR) .. " | ignoreDisplay=" .. tostring(opts.ignoreDisplay and true or false))
        smdBtn(label .. " start", btn)
        smdState(label .. " start")
        local lastRar = tostring(playerData(dataKey("rarity")))
        while AFK.gen == gen and _G.HyzePing.clock() - t0 < 600 do
            iters += 1
            if not btn.Parent then
                smd(label .. ": button lost its Parent, re-fetching")
                btn = getBtn()
                if not btn then reason, ok, status, state = "button gone (nil)", false, "button gone", "failed" break end
            end
            -- log whenever the raw Rarity text changes while buying
            local rr = tostring(playerData(dataKey("rarity")))
            if rr ~= lastRar then smd(string.format("%s: Rarity raw changed %s -> %s (iter %d)", label, lastRar, rr, iters)) lastRar = rr end
            if not opts.ignoreDisplay and isMaxedText(btn) then reason, ok, status, state = "Bought/Max text found on button", true, "maxed", "finished" break end
            if resetHappened(startR) then reason, ok, status, state = "resetHappened() = true", true, "reset", "reset" break end -- Prestige / reset already happened: stop
            if not opts.ignoreDisplay and costReady(btn) == false then
                -- cannot afford another one; confirm once (values update a moment after a purchase)
                _G.HyzePing.wait(0.3)
                if costReady(btn) == false then reason, ok, status, state = "cannot afford more (costReady=false twice)", true, "unaffordable", "finished" smdBtn(label .. " at stop", btn) break end
            end
            Touch(btn, 3)
            buys += 1
            _G.HyzePing.wait(0.1)
            local now = sig(btn)
            if now ~= last then
                if buys <= 3 or buys % 25 == 0 then smd(string.format("%s: sig changed (buy #%d): %s", label, buys, now)) end
                last = now
                lastChange = _G.HyzePing.clock()
                cLast = costLog(btn)
            end
            local hNow = hintVal()
            if hNow ~= nil then
                if hintLast ~= nil and hNow ~= hintLast then smd(string.format("%s: shared stat (Upgrade 7 gives) changed: %s (hint only, not counted)", label, hNow)) end
                hintLast = hNow
            end
            -- a purchase only counts as CONFIRMED when the stat the button gives really changed
            local gNow = givesSig(btn)
            if gNow ~= nil and gNow ~= lastGive then
                confirmed += 1
                lastGive = gNow
                lastConfirm = _G.HyzePing.clock()
                if confirmed <= 3 or confirmed % 25 == 0 then smd(string.format("%s: purchase CONFIRMED #%d (gives stat changed): %s", label, confirmed, gNow)) end
            end
            local stalled = _G.HyzePing.clock() - lastChange >= STALL
            -- Secret 2 only: displayed "cannot afford" while the currency is still RISING is not a stall: keep waiting
            -- (the outer 600 s limit still bounds this)
            if stalled and opts.classify and costReady(btn) == false then
                local cNow = costLog(btn)
                if cNow ~= nil and cLast ~= nil and cNow > cLast + 1e-9 then
                    smd(string.format("%s: not affordable yet but currency is rising (%.4f -> %.4f log10) - waiting, not a stall", label, cLast, cNow))
                    cLast, lastChange, stalled = cNow, _G.HyzePing.clock(), false
                end
            end
            local noConf = (not opts.giveOnly) and gNow ~= nil and _G.HyzePing.clock() - lastConfirm >= NOCONF
            if stalled or noConf then
                local why = stalled and ("STALL: nothing changed for " .. STALL .. "s")
                    or ("STALL: gives stat unchanged for " .. NOCONF .. "s (other stats kept changing)")
                reason = why
                smdBtn(label .. " at stall", btn)
                -- a stall AFTER confirmed purchases is the normal end (the button stopped accepting purchases).
                -- A stall with NO confirmed purchase is only acceptable when the button itself also shows it cannot be bought.
                if opts.classify then
                    -- Secret 2: the displayed cost is only used to tell "out of currency" from "stopped accepting"
                    local aff = costReady(btn)
                    if aff == false then
                        -- currency is short and not rising: NOT finished (it may become buyable once currency grows)
                        ok, state = false, "blocked-by-currency"
                        status = (confirmed > 0 and ("stopped after " .. confirmed .. " confirmed purchases; ") or "no purchase accepted; ")
                            .. "displayed cost is not affordable and the currency is not rising"
                    elseif confirmed > 0 then
                        -- purchases were confirmed, then refused although the display says affordable: it stopped accepting
                        ok, state = true, "finished"
                        status = "stalled after " .. confirmed .. " confirmed purchases while affordable (stopped accepting)"
                            .. (aff == nil and " [cost display unreadable]" or "")
                    else
                        ok, state = false, "failed"
                        status = "STALL with no confirmed purchase although the button looks available"
                    end
                elseif confirmed > 0 then
                    ok, state, status = true, "finished", "stalled after " .. confirmed .. " confirmed purchases (stopped accepting)"
                elseif costReady(btn) == false or (not opts.ignoreDisplay and isMaxedText(btn)) then
                    ok, state, status = true, "finished", "no purchase accepted (button also shows it cannot be bought)"
                else
                    ok, state, status = false, "failed", "STALL with no confirmed purchase although the button looks available"
                end
                break
            end
        end
        if ok == nil then
            if AFK.gen ~= gen then ok, status, state = true, "cancelled (Auto AFK stopped / restarted)", "cancelled"
            elseif opts.classify and costReady(btn) == false then
                ok, state, status = false, "blocked-by-currency", "maxOut limit (600s) reached while the displayed cost was still not affordable"
            else ok, state, status = false, "failed", "maxOut limit (600s) reached" end
        end
        smd(string.format("maxOut END: %s | reason=%s | ok=%s state=%s status=%s | confirmed=%d | iters=%d touches=%d | took %.1fs",
            label, reason, tostring(ok), tostring(state), tostring(status), confirmed, iters, buys, _G.HyzePing.clock() - t0))
        smdState(label .. " end")
        return ok, status, confirmed, state
    end

    -- it is time for SM: stop all activities, max Rebirth Upgrade 7, then Secret 2, then click Super Multi Get
    -- the wait before the final upgrades: farming continues normally while it counts (StopActivities is NOT set).
    -- true once SM / Prestige has stayed ready for the whole slider time.
    local WAIT_GRACE = 6 -- seconds "not ready" is tolerated before the wait restarts (readiness flickers while farming)
    AFK.waitSeen = AFK.waitSeen or {}
    local function waitCancel(name)
        -- called when the tier is not ready: only restart the wait after a real, sustained loss of readiness
        if AFK.waitStart[name] and _G.HyzePing.clock() - (AFK.waitSeen[name] or 0) > WAIT_GRACE then
            AFK.waitStart[name] = nil
        end
    end
    local function waitDone(name)
        local now = _G.HyzePing.clock()
        AFK.waitSeen[name] = now
        if not AFK.waitStart[name] then
            AFK.waitStart[name] = now
            Library.Notify("info", "Auto AFK", string.format("%s ready - farming %ds before the final upgrades", name, AFK.waitSec))
            smd(string.format("waitDone(%s): ready, wait of %ds started", name, AFK.waitSec))
            smdState("wait start")
        end
        if now - AFK.waitStart[name] >= AFK.waitSec then
            AFK.waitStart[name] = nil
            return true
        end
        return false
    end

    -- maxOut options for Secret 2 (the space-area "Rebirth Upgrade 7", child [84]): the displayed Bought!/Max text and Cost are NOT
    -- trusted to say it is finished (it keeps accepting purchases while it looks maxed). A purchase is CONFIRMED only when this
    -- button's OWN gives stat (UpgradesCashMulti) changes. Only this button is touched during the step, so the stat moving = bought.
    -- The longer stall window leaves time for a delayed server update. classify = true makes a stall end in
    -- finished / blocked-by-currency / failed.
    local function secret2Opts()
        return { ignoreDisplay = true, giveOnly = true, classify = true, stall = 8 }
    end

    -- final upgrades: stop activities, max Rebirth Upgrade 7, then Secret 2. Returns the previous StopActivities value,
    -- whether a reset was detected (aborted), and a summary { ok = bool, failures = { "label: status", ... },
    -- s2 = { state, status, confirmed } } so a stall / timeout / missing button is reported instead of looking like a clean
    -- finish. s2.state is "finished" | "blocked-by-currency" | "failed" | "skipped" | "not-run" | "reset" | "cancelled"
    -- ("timed-out" is decided by AFK.s2Decide). The caller does its reset and then restores StopActivities.
    local function finalUpgrades(gen, label)
        AFK.busy = true
        local prevStop = states.StopActivities
        states.StopActivities = true
        local skipS2 = AFK.noSecret2 or skipSecretThisSM(label)
        resetLogged = false
        smd(string.format("=== finalUpgrades START: label=%s | noSecret2=%s skipSecretTog=%s skipSecretN=%s smCount=%s => skipS2=%s ===",
            tostring(label), tostring(AFK.noSecret2), tostring(AFK.skipSecretTog), tostring(AFK.skipSecretN), tostring(AFK.smCount), tostring(skipS2)))
        smdState("before stop")
        Library.Notify("info", "Auto AFK", label .. (skipS2 and " time: activities stopped, maxing Rebirth Upgrade 7 only" or " time: activities stopped, maxing Rebirth Upgrade 7 then Secret 2"))
        finWatchStart()
        local startR = metric("rarity")
        AFK.finRP = metric("rebirth") -- baseline for reset detection (Rebirth Points)
        AFK.resetWhy = nil
        smd("finalUpgrades startR (log10) = " .. tostring(startR) .. " | StopActivities now = " .. tostring(states.StopActivities))
        if startR == nil or startR == -math.huge then smd("WARNING: startR is nil/-inf -> reset detection is unreliable") end
        local summary = { ok = true, failures = {}, otherFailures = {}, s2 = { state = skipS2 and "skipped" or "not-run" } }
        local function record(name, okR, status, confirmed, state)
            smd(string.format("finalUpgrades result: %s | ok=%s | state=%s | %s | confirmed=%s", name, tostring(okR), tostring(state), tostring(status), tostring(confirmed)))
            if name == "Secret 2" then summary.s2 = { state = state, status = status, confirmed = confirmed } end
            if not okR then
                summary.ok = false
                summary.failures[#summary.failures + 1] = name .. ": " .. tostring(status)
                if name ~= "Secret 2" then summary.otherFailures[#summary.otherFailures + 1] = name .. ": " .. tostring(status) end
            end
        end
        local ok, err = pcall(function()
            record("Rebirth Upgrade 7", maxOut(gen, function() return GetButton("RebirthUpg7") end, "Rebirth Upgrade 7", startR))
            if not skipS2 and not resetHappened(startR) then
                -- Secret 2 = the space-area "Rebirth Upgrade 7" (child [84]). A purchase counts only when ITS OWN gives stat
                -- (UpgradesCashMulti) really changes; Bought!/Max text and the displayed cost are not used (secret2Opts).
                -- The PlayerData values that change while it runs are logged to the SM debug log.
                local function pdSnap()
                    local t, pd = {}, LocalPlayer:FindFirstChild("PlayerData")
                    if pd then for _, v in ipairs(pd:GetChildren()) do if v:IsA("ValueBase") then t[v.Name] = tostring(v.Value) end end end
                    return t
                end
                pcall(function()
                    local sb = GetButton("Secret2")
                    local ps = sb and sb.Position
                    smd("Secret 2 button: " .. (sb and string.format("%s @(%.0f,%.0f,%.0f)", sb.Name, ps.X, ps.Y, ps.Z) or "nil"))
                end)
                local before = pdSnap()
                record("Secret 2", maxOut(gen, function() return GetButton("Secret2") end, "Secret 2", startR, secret2Opts()))
                pcall(function()
                    local after, diff = pdSnap(), {}
                    for k, v in pairs(after) do
                        if k ~= dataKey("rarity") and before[k] ~= v then diff[#diff + 1] = string.format("%s: %s -> %s", k, tostring(before[k]), v) end
                    end
                    table.sort(diff)
                    smd("Secret 2 PlayerData changes during the step (Rarity left out): " .. (#diff > 0 and table.concat(diff, " | ") or "none"))
                end)
            end
        end)
        if not ok then
            warn("[AutoAFK] " .. tostring(err)) smd("ERROR in finalUpgrades: " .. tostring(err))
            summary.ok = false
            summary.failures[#summary.failures + 1] = "error: " .. tostring(err)
            summary.otherFailures[#summary.otherFailures + 1] = "error: " .. tostring(err)
            if summary.s2.state == "not-run" then summary.s2 = { state = "failed", status = "error: " .. tostring(err) } end
        end
        local aborted = resetHappened(startR)
        finWatchStop()
        smd("=== finalUpgrades END: aborted=" .. tostring(aborted) .. " | upgradesOk=" .. tostring(summary.ok)
            .. " | secret2=" .. tostring(summary.s2.state)
            .. (#summary.failures > 0 and (" | failures=" .. table.concat(summary.failures, "; ")) or "") .. " ===")
        smdState("after final upgrade")
        if aborted then Library.Notify("info", "Auto AFK", "Reset detected (" .. resetReason(startR) .. ") - final upgrade stopped") end
        if not summary.ok and not aborted then
            -- not a clean finish: say so. For SM the sequence still continues (a dead upgrade must not freeze Auto AFK).
            -- For Prestige, a Secret 2 problem is reported (and handled) by AFK.s2Decide, so it is left out of this message.
            local list = (label == "Prestige") and summary.otherFailures or summary.failures
            if #list > 0 then
                Library.Notify("warning", "Auto AFK", label .. " final upgrade incomplete - " .. table.concat(list, "; "))
            end
        end
        AFK.lastFinal = summary
        AFK.busy = false
        return prevStop, aborted, summary
    end

    -- Prestige hold for Secret 2. Called after finalUpgrades(gen, "Prestige"). Returns allow, state:
    --   allow = true  -> Prestige may go ahead.  state is "finished" (genuinely finished), "skipped" (Secret 2 is switched off for
    --                    this cycle), "aborted" (a reset / Prestige already happened) or "timed-out" (see below)
    --   allow = false -> Secret 2 is blocked-by-currency / failed: Prestige is held and the normal Prestige wait + final upgrades
    --                    run again (farming goes on in between, so currency can grow)
    -- The hold is bounded by getgenv().HyzeSMWaitMax (default 900 s, the same limit the Prestige gate already uses), counted
    -- from the first non-finished result. When it is reached the state is recorded as "timed-out" - it is logged and notified as
    -- NOT finished - and Prestige proceeds once (this is the existing intended timeout fallback); there is no endless retry.
    function AFK.s2Decide(summary, aborted)
        local s2 = summary and summary.s2
        local st = s2 and s2.state
        if aborted then AFK.s2Retry = nil AFK.s2State = "aborted" return true, "aborted" end
        if st == "cancelled" then return false, "cancelled" end
        if st == nil or st == "skipped" or st == "not-run" or st == "reset" then
            AFK.s2Retry, AFK.s2State = nil, st or "skipped"
            return true, st or "skipped"
        end
        if st == "finished" then
            AFK.s2Retry, AFK.s2State = nil, "finished"
            smd("SECRET 2 state: finished | " .. tostring(s2.status))
            return true, "finished"
        end
        -- blocked-by-currency or failed
        local now = _G.HyzePing.clock()
        local r = AFK.s2Retry
        if not r then r = { since = now, tries = 0 } AFK.s2Retry = r end
        r.tries += 1
        local maxWait = (type(getgenv) == "function" and tonumber(getgenv().HyzeSMWaitMax)) or 900
        local held = now - r.since
        if held >= maxWait then
            AFK.s2Retry, AFK.s2State = nil, "timed-out"
            smd(string.format("SECRET 2 state: TIMED-OUT after %.0fs / %ds and %d tries | last state=%s | %s", held, maxWait, r.tries, tostring(st), tostring(s2.status)))
            Library.Notify("warning", "Auto AFK", string.format(
                "Secret 2 TIMED-OUT (NOT finished) after %.0fs - last state: %s. Prestige is going ahead anyway (timeout fallback).", held, tostring(st)))
            return true, "timed-out"
        end
        AFK.s2State = st
        smd(string.format("SECRET 2 state: %s (try %d, held %.0fs / %ds) | %s", tostring(st), r.tries, held, maxWait, tostring(s2.status)))
        Library.Notify("info", "Auto AFK", string.format(
            "Prestige held: Secret 2 is %s (try %d, %.0fs of %ds). Farming, then retrying the final upgrades.", tostring(st), r.tries, held, maxWait))
        return false, st
    end

    -- toggle-off variant for Prestige: still BUYS the final upgrades IN SEQUENCE (Rebirth Upgrade 7 first; when it cannot be
    -- afforded any more, Secret 2) but only within a fixed number of seconds in total (no full maxing); the caller Prestiges
    -- right after. Returns the previous StopActivities value.
    local function buyFinalFor(gen, seconds)
        AFK.busy = true
        local prevStop = states.StopActivities
        states.StopActivities = true
        Library.Notify("info", "Auto AFK", string.format("Prestige time: buying the final upgrades for up to %ds (no full maxing), then Prestige", seconds))
        finWatchStart()
        resetLogged = false
        local startR = metric("rarity")
        AFK.finRP = metric("rebirth") -- baseline for reset detection (Rebirth Points)
        AFK.resetWhy = nil
        smd("=== buyFinalFor START (" .. seconds .. "s) startR=" .. tostring(startR) .. " ===")
        smdState("buyFinalFor start")
        local ok, err = pcall(function()
            local deadline = _G.HyzePing.clock() + seconds
            local steps = { { function() return GetButton("RebirthUpg7") end, false } }
            if not AFK.noSecret2 then
                steps[2] = { function() return GetButton("Secret2") end, true } -- Secret 2 = the space-area "Rebirth Upgrade 7" (child [84])
            end
            for _, step in ipairs(steps) do
                local getBtn, isS2 = step[1], step[2]
                -- Secret 2: displayed Bought!/Cost are not trusted; it moves on when its real stat stops changing for 8s
                local lastSig, lastMove = nil, _G.HyzePing.clock()
                while AFK.gen == gen and _G.HyzePing.clock() < deadline do
                    if resetHappened(startR) then return end -- Prestige / reset already happened: stop
                    local btn = getBtn()
                    if not btn then break end
                    if isS2 then
                        local sc = btn:FindFirstChild("Script")
                        local gv = sc and sc:FindFirstChild("Whatstatgives")
                        local cur = tostring(gv and playerData(tostring(gv.Value))) -- Secret 2's own gives stat only
                        if cur ~= lastSig then lastSig, lastMove = cur, _G.HyzePing.clock() end
                        if _G.HyzePing.clock() - lastMove >= 8 then break end
                    else
                        if isMaxedText(btn) then break end
                        if costReady(btn) == false then break end -- cannot afford more of this one: next upgrade
                    end
                    Touch(btn, 3)
                    _G.HyzePing.wait(0.1)
                end
            end
        end)
        if not ok then warn("[AutoAFK] " .. tostring(err)) smd("ERROR in buyFinalFor: " .. tostring(err)) end
        local aborted = resetHappened(startR)
        finWatchStop()
        smd("=== buyFinalFor END: aborted=" .. tostring(aborted) .. " ===")
        smdState("buyFinalFor end")
        if aborted then Library.Notify("info", "Auto AFK", "Reset detected (" .. resetReason(startR) .. ") - final upgrade stopped") end
        AFK.busy = false
        return prevStop, aborted
    end

    -- after Prestige: just like finalUpgrades - activities stay stopped and each prestige upgrade whose toggle is ON in the
    -- Prestige tab is maxed out, ONE button at a time (Raise Time, RP, SM, PP). Auto AFK buys nothing else on its own.
    -- The Prestige tab loops pause meanwhile (states.PrestigeBuying) so only one button is pressed at a time.
    local function buyPrestigeUpgrades(gen)
        local list = {
            { "RaiseTimePoint", "RaiseTime", "Raise Time Prestige" },
            { "RPPrestige", "RPPrestige", "RP Prestige" },
            { "SMPrestige", "SMPrestige", "SM Prestige" },
            { "PPPrestige", "PPPrestige", "PP Prestige" },
        }
        local any = false
        for _, e in ipairs(list) do if states[e[1]] then any = true end end
        if not any then return end -- no Prestige tab toggle is on: nothing to buy
        AFK.busy = true
        states.StopActivities = true
        states.PrestigeBuying = true
        Library.Notify("info", "Auto AFK", "Prestige done: activities stopped, buying the prestige upgrades one at a time")
        FIN.pressed = false -- the old Prestige press must not stop this
        local ok, err = pcall(function()
            for _, e in ipairs(list) do
                if AFK.gen ~= gen then return end
                if states[e[1]] then
                    maxOut(gen, function() return GetButton(e[2]) end, e[3], nil)
                end
            end
        end)
        if not ok then warn("[AutoAFK] " .. tostring(err)) end
        states.PrestigeBuying = false
        AFK.busy = false
    end

    local function prepareSM(gen)
        local prevStop, aborted = finalUpgrades(gen, "SM")
        local done = false
        if AFK.gen == gen and not aborted then done = performReset("sm", gen) end
        if not done then
            AFK.lastTry.sm = _G.HyzePing.clock() + 52 -- failed: wait ~60s before trying again
        elseif AFK.t.sm and not AFK.t.sm.recovering then
            -- No measurable SM rebuild was started; still make the Prestige-vs-Rebirth decision.
            AFK.smRecoveryJustFinished = true
        end
        states.StopActivities = prevStop -- activities back on
    end

    -- current Ascension count as a plain number ("0;5" -> 5); nil when unreadable
    local function ascensionCount()
        local raw = playerData(dataKey("ascension"))
        local layer, num = tostring(raw or ""):match("^(%d+);(.+)$")
        layer, num = tonumber(layer), tonumber(num)
        if not layer or not num then return nil end
        if layer == 0 then return num end
        return math.huge
    end

    -- true while another Ascension is still allowed by the limit box (0 = unlimited)
    local function ascensionAllowed()
        local lim = AFK.ascLimit or 0
        if lim <= 0 then return true end
        local cnt = ascensionCount()
        if cnt == nil then return true end -- unreadable: do not block
        if cnt >= lim then
            if not AFK.ascLimitMsg then
                AFK.ascLimitMsg = true
                Library.Notify("success", "Auto AFK", "Ascension limit reached (" .. lim .. ") - Auto Ascend stopped")
            end
            return false
        end
        AFK.ascLimitMsg = false
        return true
    end

    -- Rebirth button watcher for the 80 s safeguard: remembers when workspace.Buttons["Rebirth Get"] was last touched by your character
    -- (by this script's firetouchinterest or by hand). Reconnects by itself if the button instance is replaced.
    function AFK.rbWatch()
        local rb = ButtonsFolder:FindFirstChild("Rebirth Get")
        if rb == AFK.rbWatchBtn and AFK.rbConn then return end
        if AFK.rbConn then pcall(function() AFK.rbConn:Disconnect() end) AFK.rbConn = nil end
        AFK.rbWatchBtn = rb
        if rb and rb:IsA("BasePart") then
            AFK.rbConn = rb.Touched:Connect(function(hit)
                local ch = LocalPlayer.Character
                if ch and hit and hit:IsDescendantOf(ch) then
                    AFK.rbFiredAt = _G.HyzePing.clock()
                    AFK.rbFires = (AFK.rbFires or 0) + 1
                end
            end)
        end
    end

    local function afkLoop(gen)
        local function active() return AFK.gen == gen end
        -- Roll Rarity farming runs on its own so it never stops while resets are processed
        task.spawn(function()
            while active() do
                if states.StopActivities then _G.HyzePing.wait(0.5) else rollOnce() _G.HyzePing.wait() end
            end
        end)
        while active() do
            AFK.tick = (AFK.tick or 0) + 1
            if states.StopActivities or AFK.busy then
                _G.HyzePing.wait(0.3)
            else
                local ok, err = pcall(function()
                    updateRecoveries()
                    -- After SM recovery, continue to Prestige only if its button and gate are ready.
                    -- Otherwise restart the Rebirth -> SM cycle without interrupting the completed recovery.
                    if AFK.smRecoveryJustFinished then
                        AFK.smRecoveryJustFinished = false
                        local prestigeReady = not anyRecovering("prestige", "sm", "rebirth")
                            and ready("prestige", true) and prestigeGate()
                        if prestigeReady then
                            AFK.mode = "prestige"
                            AFK.rbIdle = nil
                            Library.Notify("success", "Auto AFK", "SM recovery complete - Prestige is ready; continuing to Prestige")
                        else
                            AFK.mode = "rebirth"
                            AFK.rbIdle = nil
                            AFK.waitStart.sm = nil
                            AFK.waitStart.prestige = nil
                            Library.Notify("info", "Auto AFK", "SM recovery complete - Prestige not ready; returning to Rebirth")
                        end
                    end
                    -- SAFEGUARD (Rebirth button watch): while in Rebirth mode the script watches workspace.Buttons["Rebirth Get"].
                    -- The moment it sees that button fire (touched by your character - by this script or by hand) even ONCE, an 80 s
                    -- countdown starts. When it runs out, the unfinished Rebirth measurement is dropped and the mode moves on to SM.
                    -- Fires seen while the mode is NOT "rebirth" are ignored (rbArmAfter), so every new Rebirth stretch needs a fresh
                    -- fire to arm it again: it works every cycle, not only after boot. HyzePing.clock does not count frozen time.
                    AFK.rbWatch()
                    if AFK.mode == "rebirth" and NEXT_MODE.rebirth then
                        local nowC = _G.HyzePing.clock()
                        if not AFK.rbIdle and AFK.rbFiredAt and AFK.rbFiredAt > (AFK.rbArmAfter or 0) then
                            AFK.rbIdle = nowC
                            smd("Rebirth Get fired - 80s safeguard countdown started")
                        end
                        if AFK.rbIdle and nowC - AFK.rbIdle >= 80 then
                            AFK.rbIdle = nil
                            AFK.rbArmAfter = nowC
                            -- Cancel only the unfinished Rebirth measurement so it cannot block the next mode.
                            local rbRec = AFK.t and AFK.t.rebirth
                            if rbRec then rbRec.recovering = false end
                            AFK.mode = NEXT_MODE.rebirth
                            smd("80s safeguard elapsed (counted from the first Rebirth Get fire) -> advancing to " .. tostring(AFK.mode))
                            Library.Notify("info", "Auto AFK", "80s Rebirth safeguard elapsed -> advancing to " .. tostring(AFK.mode))
                        end
                    else
                        AFK.rbIdle = nil
                        AFK.rbArmAfter = _G.HyzePing.clock()
                    end
                    local rl = metric("rarity")
                    if rl and rl > -math.huge and (PG.peak == nil or rl > PG.peak) then PG.peak = rl end
                    runUpgrades()
                    -- Rebirth (never while the previous rebirth is still being rebuilt)
                    if not AFK.waitStart.sm and not AFK.waitStart.prestige
                        and not anyRecovering("rebirth") and ready("rebirth") then performReset("rebirth", gen) end
                    -- Prestige availability is decided BEFORE Super Multi Get so Prestige wins when both are available.
                    -- (SM is only a gate for Prestige; the gate itself is unchanged.)
                    local prestigeAvail = (AFK.mode == "prestige" or AFK.mode == "ascension")
                        and not anyRecovering("prestige", "sm", "rebirth") and ready("prestige", true)
                    local prestigeGo = prestigeAvail and prestigeGate()
                    -- SM stands down while Prestige is available, except when Prestige is itself waiting for an
                    -- SM Upgrade to become affordable (SM must be able to run then, otherwise nothing could ever pass the gate)
                    local holdSM = prestigeAvail and (prestigeGo or (PG.why ~= "SM Upgrade not affordable yet" and not PG.needSM))
                    -- Super Multi Get
                    if not holdSM and AFK.mode ~= "rebirth" and not anyRecovering("sm", "rebirth") and ready("sm") then
                        if waitDone("sm") then prepareSM(gen) end
                    elseif holdSM then
                        AFK.waitStart.sm = nil -- Prestige is available: SM stands down immediately
                    else
                        waitCancel("sm") -- not ready: restart the wait only after the grace period
                    end
                    -- Prestige
                    if prestigeGo and ready("prestige") then
                        if waitDone("prestige") then
                            local prevStop, aborted
                            local s2Allow = true -- Prestige only goes ahead when Secret 2 is finished (or skipped / timed-out, see AFK.s2Decide)
                            if AFK.finalStop then
                                local fsum
                                prevStop, aborted, fsum = finalUpgrades(gen, "Prestige") -- original: buy the final upgrades, then Prestige
                                s2Allow = AFK.s2Decide(fsum, aborted)
                            else
                                -- toggle off: buy the final upgrades for 3 seconds only (no maxing), then Prestige
                                prevStop, aborted = buyFinalFor(gen, 3)
                            end
                            -- if Prestige was already pressed during the final upgrade, do not press it again
                            local prestiged = aborted -- pressed by hand during the final upgrade = it happened
                            if AFK.gen == gen and not aborted and s2Allow then prestiged = performReset("prestige", gen) end
                            -- NEW: after Prestige, buy ALL the prestige upgrades (activities still stopped) before farming again
                            if AFK.gen == gen and prestiged then AFK.s2Retry = nil buyPrestigeUpgrades(gen) end
                            states.StopActivities = prevStop
                        end
                    else
                        waitCancel("prestige")
                    end
                    -- Ascension: no waiting for the sequence - as soon as an Ascension is possible it is done,
                    -- until the Ascension limit (Extras tab) is reached. A failed try (not able yet) retries in ~60s.
                    if _G.HyzePing.clock() - (AFK.lastTry.ascension or 0) >= 8 and ascensionAllowed() then
                        local abtn = TIERS.ascension.btn()
                        if abtn then
                            local avail = true -- unknown requirement: probe, the result is verified (Ascension count must change)
                            local reqL = requirementOf(abtn)
                            local curL = metric("rarity")
                            if reqL and curL and curL > -math.huge then
                                avail = curL >= reqL - 1e-9 -- readable requirement: only try once it is met
                            end
                            if avail and costReady(abtn) == false then avail = false end
                            if avail and not performReset("ascension", gen) then
                                -- not able to ascend yet: back off ~60s so the Rebirth / SM / Prestige cycle keeps running
                                AFK.lastTry.ascension = _G.HyzePing.clock() + 52
                            end
                        end
                    end
                end)
                if not ok then
                    warn("[AutoAFK] " .. tostring(err))
                    if AFK.lastErr ~= tostring(err) then
                        AFK.lastErr = tostring(err)
                        smd("LOOP ERROR: " .. tostring(err))
                    end
                end
                _G.HyzePing.wait(0.25)
            end
        end
    end

    -- heartbeat for the SM debug log: shows what Auto AFK is doing (also when it looks stuck)
    function AFK.heartbeat(gen)
        local lastMode, lastTick = nil, 0
        while AFK.gen == gen do
            pcall(function()
                local now = _G.HyzePing.clock()
                if lastMode ~= AFK.mode then
                    smd("MODE CHANGE: " .. tostring(lastMode) .. " -> " .. tostring(AFK.mode))
                    lastMode = AFK.mode
                end
                local parts = {}
                for _, name in ipairs({ "rebirth", "sm", "prestige" }) do
                    local rec = AFK.t[name]
                    if rec and rec.recovering then
                        parts[#parts + 1] = string.format("%s:RECOVERING %.0fs target=%s cur=%s", name, now - (rec.recStart or now), tostring(rec.target), tostring(TIERS[name].rebuild()))
                    else
                        parts[#parts + 1] = name .. ":idle"
                    end
                end
                local rbtn = TIERS.rebirth.btn()
                local req = rbtn and requirementOf(rbtn)
                local cur = metric("rarity")
                local rem = nil
                if req and cur then rem = remainingPct(cur, req) end
                local rdy = "?"
                pcall(function() rdy = tostring(ready("rebirth", true)) end)
                local tick = AFK.tick or 0
                smd(string.format("HEARTBEAT mode=%s | loop ticks +%d | busy=%s StopAct=%s | %s | rbIdle=%s | rebirthBtn=%s req=%s cur=%s remaining%%=%s ready(rebirth)=%s | smWait=%s prestigeWait=%s | lastErr=%s",
                    tostring(AFK.mode), tick - lastTick, tostring(AFK.busy), tostring(states.StopActivities), table.concat(parts, " ; "),
                    AFK.rbIdle and string.format("%.0fs", now - AFK.rbIdle) or "nil",
                    tostring(rbtn ~= nil), tostring(req), tostring(cur), tostring(rem), rdy,
                    AFK.waitStart.sm and string.format("%.0fs", now - AFK.waitStart.sm) or "nil",
                    AFK.waitStart.prestige and string.format("%.0fs", now - AFK.waitStart.prestige) or "nil",
                    tostring(AFK.lastErr)) .. string.format(" | rbFires=%d lastRebirthGetFire=%s", AFK.rbFires or 0,
                    AFK.rbFiredAt and string.format("%.0fs ago", now - AFK.rbFiredAt) or "never"))
                lastTick = tick
            end)
            _G.HyzePing.wait(20)
        end
    end

    local function setAutoAFK(on)
        AFK.gen += 1
        AFK.busy = false
        if AFK.rbConn then pcall(function() AFK.rbConn:Disconnect() end) AFK.rbConn, AFK.rbWatchBtn = nil, nil end
        if on then
            AFK.mode, AFK.cycle, AFK.lastTry = "rebirth", 1, {}
            AFK.rbIdle, AFK.rbFiredAt, AFK.rbArmAfter, AFK.rbFires = nil, nil, nil, 0 -- the 80 s safeguard always starts fresh with Auto AFK
            AFK.waitStart, AFK.waitSeen = {}, {}
            PG.peak, PG.oldRarity, PG.waitSince, PG.lastMsg = nil, nil, nil, 0
            AFK.smCount, PG.needSM = 0, false
            AFK.s2Retry, AFK.s2State = nil, nil
            AFK.t = { rebirth = {}, sm = {}, prestige = {} }
            if not playerData(dataKey("rarity")) then
                Library.Notify("warning", "Auto AFK", "PlayerData." .. dataKey("rarity") .. " not found")
            end
            if not Workspace:FindFirstChild("Roll System") then
                Library.Notify("warning", "Auto AFK", 'workspace["Roll System"] not found')
            end
            task.spawn(afkLoop, AFK.gen)
            task.spawn(AFK.heartbeat, AFK.gen)
        end
    end

