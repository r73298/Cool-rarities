        -- ---- progress report ----
        local function doReport()
            if WB.busyReport then return end
            WB.busyReport = true
            local ok, err = pcall(function()
                local S = WB.S
                local cur = readAll()
                if S.prev then -- a currency that could not be read this time keeps its previous reading
                    for _, c in ipairs(CURRENCIES) do if not cur[c.id] then cur[c.id] = S.prev[c.id] end end
                end
                local nowT = _G.HyzePing.clock()
                local first = S.base == nil
                if first then S.base, S.startAt = cur, nowT end
                local elapsed = S.last and (nowT - S.last) or 0
                local gained, perHour, total, current = {}, {}, {}, {}
                for _, c in ipairs(CURRENCIES) do
                    local g, h = gainText(S.prev and S.prev[c.id], cur[c.id], elapsed)
                    local t = gainText(S.base[c.id], cur[c.id], math.max(nowT - S.startAt, 1))
                    gained[#gained + 1] = g .. " " .. c.label:lower()
                    perHour[#perHour + 1] = h .. " " .. c.label:lower()
                    total[#total + 1] = t .. " " .. c.label:lower()
                    current[#current + 1] = { name = c.label, value = cur[c.id] and ("`" .. fmtVal(cur[c.id]) .. "`") or "`not found`", inline = true }
                end
                local fields = {}
                if not first then
                    fields[#fields + 1] = { name = "Gained", value = table.concat(gained, "\n"), inline = true }
                    fields[#fields + 1] = { name = "Per hour", value = table.concat(perHour, "\n"), inline = true }
                    fields[#fields + 1] = { name = "Total", value = table.concat(total, "\n"), inline = true }
                end
                for _, f in ipairs(current) do fields[#fields + 1] = f end
                local desc = first and "**PROGRESS REPORT**   `started`"
                    or string.format("**PROGRESS REPORT**   `last %s`   `running %s`", wbDur(elapsed), wbDur(nowT - S.startAt))
                if wbSend(embed(desc, 5793266, fields, "progress")) then
                    S.prev, S.last = cur, nowT
                else
                    if first then S.base, S.startAt = nil, nil end
                end
            end)
            WB.busyReport = false
            if not ok then warn("[Webhook] " .. tostring(err)) end
        end
        local function startProgress()
            WB.gen = WB.gen + 1
            local my = WB.gen
            WB.S = {}
            task.spawn(function()
                doReport() -- baseline report right away
                local attempt = _G.HyzePing.clock()
                while WB.gen == my do
                    _G.HyzePing.wait(1)
                    if _G.HyzePing.clock() - attempt >= WB.min * 60 then
                        attempt = _G.HyzePing.clock()
                        doReport()
                    end
                end
            end)
        end

        -- ---- notifications -> webhook (instant, queued so Discord rate limits never block the script) ----
